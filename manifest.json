{
  "manifest_version": 3,
  "name": "github-root-commit",
  "version": "1.1",

  "description": "Jumps to the oldest first commit.",

  "icons": {
    "48": "icons/github-root-commit.png"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "github-root-commit@anxhul10",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "content_scripts": [
    {
      "matches": ["*://github.com/*/*/commits/*", "*://github.com/*/*"],
      "js": ["main.js"],
      "css": ["button.css"]
    }
  ]
}